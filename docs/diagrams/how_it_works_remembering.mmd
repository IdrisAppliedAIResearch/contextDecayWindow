---
config:
  layout: elk
---
flowchart TB

    subgraph READ["REMEMBERING — happens before every reply"]
        direction TB
        subgraph INPUTS["INPUTS"]
            direction LR
            Q["You send a new message"]
            QE["Turn your message into<br/>the same kind of numbers"]
            ALL["Load every exchange ever stored"]
            Q --> QE
        end

        subgraph ROUTES["THREE READ ROUTES"]
            direction LR
            RECENT["CONTINUITY<br/>Take the latest 32 complete exchanges,<br/>in conversation order"]
            DENSE["Compare meaning with every exchange<br/>Dense cosine score"]
            BM25["Compare the words in your message<br/>with every exchange — BM25"]
        end
        ALL --> RECENT
        QE --> DENSE
        ALL --> DENSE
        Q --> BM25
        ALL --> BM25

        DENSE --> FUSE["Normalize both score lists per message<br/>Combine 80% meaning + 20% words"]
        BM25 --> FUSE
        FUSE --> RANK["Rank the complete store best first<br/>Skip anything already in the latest 32"]
        RANK --> FLAG{"Optional structured spread enabled?"}

        subgraph ALLOCATION["LONG-TERM ALLOCATION"]
            direction LR
            FULL["DEFAULT<br/>Give CC80 the full<br/>32,000-character retrieval box"]
            SEM["ASPECT ON<br/>CC80 fills one protected half"]
            FACETS["Extract people, dates, numbers,<br/>noun phrases, events and relations"]
            ASPECT["ASPECT fills the other half with<br/>new structured facets, no duplicates"]
            RETURN["Merge once, then return every unused<br/>character to unchanged CC80 order"]
            SEM --> ASPECT
            FACETS --> ASPECT --> RETURN
        end
        FLAG -->|"no — default"| FULL
        FLAG -->|"yes"| SEM
        ALL --> FACETS

        FULL --> PACK["Pack complete long-term exchanges at exact size<br/>Too big to fit? Skip it and continue"]
        RETURN --> PACK
        PACK --> CEIL{"Long-term block is at most<br/>32,000 characters"}

        subgraph OUTPUTS["OUTPUTS"]
            direction LR
            RENDER["Write two labelled sections:<br/>latest continuity + long-term retrieval"]
            OUT["Handed to the model as part of its prompt<br/>Recent continuity is additive to the 32k box"]
            REP["A receipt<br/>Total and retrieval characters, what went in,<br/>what was dropped, and which route owned it"]
            RENDER --> OUT
        end
        RECENT --> RENDER
        CEIL --> RENDER
        PACK --> REP
    end

    classDef store fill:#16273d,stroke:#6aa2e0,color:#cfe2fb;
    classDef optional fill:#2b2140,stroke:#a98adf,color:#eadfff;
    classDef guard fill:#22262a,stroke:#9aa5ab,color:#d5dde2;
    class ALL,RANK store;
    class FLAG,FACETS,SEM,ASPECT,RETURN optional;
    class CEIL guard;
