flowchart TD

    subgraph READ["REMEMBERING — happens before every reply"]
        direction TB
        Q["You send a new message"] --> QE["Turn your message into<br/>the same kind of numbers"]
        ALL["Load every exchange ever stored"]

        ALL --> RECENT["CONTINUITY<br/>Take the latest 32 complete exchanges,<br/>in conversation order"]
        QE --> DENSE["Compare meaning with every exchange<br/>Dense cosine score"]
        ALL --> DENSE
        Q --> BM25["Compare the words in your message<br/>with every exchange — BM25"]
        ALL --> BM25

        DENSE --> FUSE["Normalize both score lists per message<br/>Combine 80% meaning + 20% words"]
        BM25 --> FUSE
        FUSE --> RANK["Rank the complete store best first<br/>Skip anything already in the latest 32"]

        RANK --> FLAG{"Optional structured spread enabled?"}
        FLAG -->|"no — default"| FULL["Give CC80 the full<br/>32,000-character retrieval box"]
        FLAG -->|"yes"| SEM["CC80 fills one protected half"]
        ALL --> FACETS["Extract people, dates, numbers,<br/>noun phrases, events and relations"]
        SEM --> ASPECT["ASPECT fills the other half with<br/>new structured facets, no duplicates"]
        FACETS --> ASPECT
        ASPECT --> RETURN["Merge once, then return every unused<br/>character to unchanged CC80 order"]

        FULL --> PACK["Pack complete long-term exchanges at exact size<br/>Too big to fit? Skip it and continue"]
        RETURN --> PACK
        PACK --> CEIL{"Long-term block is at most<br/>32,000 characters"}

        RECENT --> RENDER["Write two labelled sections:<br/>latest continuity + long-term retrieval"]
        CEIL --> RENDER
        RENDER --> OUT["Handed to the model as part of its prompt<br/>Recent continuity is additive to the 32k box"]
        PACK --> REP["A receipt<br/>Total and retrieval characters, what went in,<br/>what was dropped, and which route owned it"]
    end

    classDef store fill:#16273d,stroke:#6aa2e0,color:#cfe2fb;
    classDef optional fill:#2b2140,stroke:#a98adf,color:#eadfff;
    classDef guard fill:#22262a,stroke:#9aa5ab,color:#d5dde2;

    class ALL,RANK store;
    class FLAG,FACETS,ASPECT optional;
    class CEIL guard;
