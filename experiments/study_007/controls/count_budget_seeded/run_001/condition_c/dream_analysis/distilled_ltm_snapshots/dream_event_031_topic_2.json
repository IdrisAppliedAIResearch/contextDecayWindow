    {
      "id": "942ff87f-a06d-53e0-a131-ce246488d540",
      "source_episode_id": "f3cbc15a-57a9-402d-9780-4e18af99a91e",
      "topic_id": "b97b6037-35b8-41c1-bb2d-a23ca926d9b5",
      "topic_label": "topic_2",
      "text": "**Advanced Phase (Years 26–50):** Annual inspections with 100% UT testing of all cables every 10 years.",
